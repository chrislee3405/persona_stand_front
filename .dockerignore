.git
.gitignore
# `.env` IS in the build context -- it holds only non-secret VITE_* build
# config that gets inlined into the public bundle anyway. Only local /
# secret overrides are excluded:
.env.local
.env.*.local
node_modules
dist
build
.vscode
.idea
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache

# Tests run before image publication; the runtime serves only the app build.
src/test/
vitest.config.ts
TESTING.md
test-results/
coverage/

image.json
scripts/publish_image.py
scripts/test_publish_image.py
**/__pycache__
