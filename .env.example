# Copy to .env (gitignored) for `npm run dev`, `npm run build` and local
# docker builds. CI does not read this file: it writes .env from the
# VITE_CDN_BASE repository Variable instead.
#
# REQUIRED. The CloudFront distribution that serves every image and video,
# with no trailing slash. The build fails without it (see vite.config.ts).
# VITE_* values are compiled into the public bundle, so never put a secret in
# a VITE_ variable.
VITE_CDN_BASE=https://<cloudfront-domain>
