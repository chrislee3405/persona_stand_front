# HTTPS MODE -- chosen by select-mode.sh when TLS_DOMAIN is set. It fills in
# ${TLS_DOMAIN} and ${HSTS_MAX_AGE} (and nothing else -- nginx's own $variables
# are left alone) and writes the result to /etc/nginx/conf.d/default.conf.
#
# The certificate is issued and renewed by certbot ON THE EC2 HOST, not in
# this container; a certbot deploy hook copies it into the directory mounted
# at /etc/nginx/certs and reloads nginx. See persona_stand_ec2yml Part A,
# "HTTPS with Let's Encrypt".

# HSTS tells a browser to use HTTPS for this host for max-age seconds, even
# if a link says http://. Sent only over HTTPS (browsers ignore it over
# HTTP). No includeSubDomains and no preload: both are hard to undo, and
# nothing else on the domain has been checked to serve HTTPS.
#
# HSTS_MAX_AGE starts short on purpose. If HTTPS breaks while a long policy
# is cached, visitors cannot fall back to HTTP until it expires -- so run
# at the default for a few days, then raise it to 31536000 (a year).
map $scheme $hsts_header {
    https   "max-age=${HSTS_MAX_AGE}";
    default "";
}

# Port 80 (published from 8080) in HTTPS mode: three jobs, and no site.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    # Certificate renewals. certbot on the host writes challenge files into
    # the webroot mounted here, and Let's Encrypt fetches them over plain
    # HTTP by design -- so this must NOT redirect.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    # The container healthcheck, which runs inside the container over HTTP.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Everything else goes to HTTPS -- to the configured domain, not to
    # whatever Host was asked for, so a visitor who typed the bare IP lands
    # on a name the certificate actually covers.
    location / {
        return 301 https://${TLS_DOMAIN}$request_uri;
    }
}

server {
    # 8443 for the same reason as 8080: nginx runs as a non-root user, so it
    # cannot bind 443 inside the container. docker-compose.ec2.yml publishes
    # "443:8443".
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${TLS_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Mozilla's "intermediate" profile: TLS 1.2 and 1.3, letting modern
    # clients pick their own (all-strong) TLS 1.3 suites.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:persona_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/persona/site.conf;
}
